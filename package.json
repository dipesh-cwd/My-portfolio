    "@tailwindcss/vite": "^4.1.17",
    "dayjs": "^1.11.19",
    "gsap": "^3.13.0",
    "immer": "^11.0.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-masonry-css": "^1.0.16",
    "react-tooltip": "^5.30.0",
    "tailwindcss": "^4.1.17",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.1",
