# Copy to .env (never commit .env). All optional.

# Public URL of the deployed site, used for social-preview tags (og:image, canonical).
# On Vercel this is filled in automatically from your project's domain; set it yourself
# if you host elsewhere, or if you add a custom domain later.
# Example: https://your-name.vercel.app
VITE_SITE_URL=

# When set, the Contact form POSTs { name, email, message } here as JSON.
# When empty, it opens the visitor's email app instead (mailto:).
# Example for the future backend: http://localhost:5000/api/contact
VITE_CONTACT_ENDPOINT=
